{
  "name": "flashcard-study-app",
  "version": "1.0.0",
  "description": "Modern flashcard study interface with spaced repetition algorithm",
  "main": "public/js/app.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "serve": "php artisan serve",
    "dev:full": "concurrently \"npm run dev\" \"npm run serve\"",
    "lint": "eslint public/js --ext .js,.vue",
    "lint:fix": "eslint public/js --ext .js,.vue --fix",
    "format": "prettier --write public/js public/css",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "flashcards",
    "study",
    "learning",
    "spaced-repetition",
    "vue",
    "laravel"
  ],
  "author": "Flashcard App Team",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.5.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "eslint-plugin-vue": "^9.19.2",
    "prettier": "^3.1.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "vue": "^3.3.8",
    "axios": "^1.6.2"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
